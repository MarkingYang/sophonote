      "id": "A01",
      "group": "A",
      "title": "普通问答采用通用稳定顺序",
      "input": {
        "kind": "route",
        "request": {
          "message": "你好，请帮我解答问题",
          "workspacePermissionMode": "plan"
        }
      },
      "expected": {
        "selected": "hermes",
        "sideEffects": "不启动模型或工具，不更改原请求"
      },
      "contractTest": "agent::automatic::acceptance::a01",
      "evidenceLevel": "host_contract",
      "releaseRequirement": "还需真实原生合同与宿主验收证据，单项合同通过不代表整场任务通过"
    },
