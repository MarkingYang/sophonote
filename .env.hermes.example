# 仅用于“开发附着”，不是正式包的生产配置。
# 复制为 .env.hermes.local（已被 *.local gitignore），再 ./scripts/sophonote.sh restart。
# TOKEN 与启动 `hermes serve` 的 HERMES_DASHBOARD_SESSION_TOKEN 一致，勿提交仓库或写入日志。

SOPHONOTE_HERMES_ATTACH_EXTERNAL=1
SOPHONOTE_HERMES_GATEWAY_URL=ws://127.0.0.1:9119/api/ws
SOPHONOTE_HERMES_GATEWAY_TOKEN=
# Hermes Session / Skill / Memory 的唯一运行目录；使用绝对路径，不写 ~。
SOPHONOTE_HERMES_HOME=

# 旧 `/v1/runs` API 仅用于迁移诊断，产品 Chat 不再读取：
# SOPHONOTE_HERMES_BASE_URL=http://127.0.0.1:18642
# SOPHONOTE_HERMES_API_KEY=
